nline-block;font-size:12px;font-weight:700;letter-spacing:.06em;background:var(--violet-soft);color:var(--violet-deep);padding:2px 8px;margin-bottom:10px}\n.plan-body ul{list-style:none;padding:0;margin:0 0 12px}\n.plan-body li{position:relative;padding-left:20px;font-size:15px;margin-bottom:6px}\n.plan-body li::before{content:\"\";position:absolute;left:2px;top:.62em;width:8px;height:8px;background:var(--violet)}\n.plan-foot{font-size:13.5px;color:var(--ink-soft);border-top:1px dashed #c8c6d2;padding-top:10px;margin:0}\n.plan.is-featured{border-color:var(--violet-deep);box-shadow:6px 6px 0 var(--violet-soft)}\n.plan.is-featured .plan-head{border-bottom-color:var(--violet-deep)}\n.plan.is-featured .plan-note{background:var(--violet-deep);color:#fff}\n\n/* 客户端 */\n.client-grid{display:grid;gap:16px}\n.client{border:2px solid var(--line);background:var(--paper-2);padding:18px 20px}\n.client h3{font-size:16px}\n.client p{font-size:14.5px;color:var(--ink-soft);margin-bottom:8px}\n.client .status{font-size:12px;letter-spacing:.08em;font-weight:700;color:var(--violet-deep)}\n.client .status::before{content:\"— \"}\n\n/* 使用步骤 */\n.steps{counter-reset:st;list-style:none;padding:0;margin:0}\n.steps li{counter-increment:st;position:relative;padding:0 0 0 46px;margin-bottom:20px}\n.steps li::before{content:counter(st,decimal-leading-zero);position:absolute;left:0;top:-4px;font-size:22px;font-weight:800;color:var(--violet);letter-spacing:-.04em}\n\n/* FAQ 折叠 */\ndetails{border:2px solid var(--line);background:var(--paper-2);margin:0 0 12px}\ndetails[open]{border-color:var(--violet-deep)}\nsummary{cursor:pointer;list-style:none;padding:14px 44px 14px 18px;font-weight:700;font-size:15.5px;position:relative}\nsummary::-webkit-details-marker{display:none}\nsummary::after{content:\"+\";position:absolute;right:16px;top:12px;font-size:19px;color:var(--violet-deep);font-weight:700}\ndetails[open] summary::after{content:\"–\"}\ndetails .ans{padding:0 18px 16px;font-size:14.8px;color:var(--ink-soft);border-top:1px dashed #c8c6d2;margin-top:0;padding-top:12px}\ndetails .ans p:last-child{margin-bottom:0}\n\nfooter{padding:34px 0 0;margin-top:40px;border-top:2px solid var(--line);font-size:13px;color:var(--ink-soft)}\nfooter .wrap{padding:0 34px}\n\n@media (max-width:820px){\n  .shell{display:block}\n  .sidenav{position:static;width:auto;max-height:none;border-right:none;border-bottom:2px solid var(--line);padding:18px 20px 16px}\n  .sidenav ul{display:flex;flex-wrap:wrap;gap:2px 0}\n  .sidenav li{margin:0}\n  .sidenav a{padding:5px 10px;border-left:none;border-bottom:2px solid transparent}\n  .sidenav a:hover{border-left:none;border-bottom-color:var(--violet)}\n  .navfoot{display:none}\n  .wrap{padding:0 20px}\n  .hero{padding:32px 0 20px}\n  .plan-price{margin-left:0;width:100%}\n  footer .wrap{padding:0 20px}\n}\n</style><div class=\"shell\">\n  <nav class=\"sidenav\" aria-label=\"页面目录\">\n    <a class=\"brandmark\" href=\"#top\">MarsLink<span class=\"dot\">.</span></a>\n    <div class=\"brandsub\">订阅说明</div>\n    <ul>\n      <li><a href=\"#start\">从哪里开始</a></li>\n      <li><a href=\"#plans\">套餐怎么选</a></li>\n      <li><a href=\"#clients\">客户端</a></li>\n      <li><a href=\"#howto\">上手四步</a></li>\n      <li><a href=\"#billing\">计费与流量</a></li>\n      <li><a href=\"#faq\">常见问题</a></li>\n    </ul>\n    <div class=\"navfoot\">\n      本页信息以文字说明为主。<br>价格与权益如有变化，以页面更新为准。\n    </div>\n  </nav>\n\n  <main id=\"top\">\n    <header class=\"hero\">\n      <div class=\"wrap\">\n        <span class=\"kicker\">MarsLink 使用导览</span>\n        <h1>MarsLink，<em>先看清楚</em>，再决定要不要订阅。</h1>\n        <p>挑订阅这件事，最烦的是看不明白。所以我们把三档套餐的流量、设备数、线路说明都写在明面上，把客户端的情况也一并交代。你可以按顺序往下读，也可以直接跳到关心的那一节。</p>\n\n        <ol class=\"timeline\">\n          <li>\n            <span class=\"step\">第 1 步</span>\n            <span class=\"t\">先算你一个月大概用多少</span>\n            <p class=\"d\">手机加电脑一起算，别忘了平板和电视盒子。数字估高了不心疼，估低了中途换档更麻烦。</p>\n          </li>\n          <li>\n            <span class=\"step\">第 2 步</span>\n            <span class=\"t\">对照套餐里的设备台数</span>\n            <p class=\"d\">同时在线设备和“能装几个”是两回事。这一栏是按同时在线写的，够用就好。</p>\n          </li>\n          <li>\n            <span class=\"step\">第 3 步</span>\n            <span class=\"t\">看看客户端能不能装在你的设备上</span>\n            <p class=\"d\">你手上的系统决定了要用哪类客户端。这一节只讲清楚现状，不夸大。</p>\n          </li>\n          <li>\n            <span class=\"step\">第 4 步</span>\n            <span class=\"t\">按年还是按月，最后再定</span>\n            <p class=\"d\">年付省下来的钱是真的，但前提是你确定会持续用。不确定就先按月。</p>\n          </li>\n          <li>\n            <span class=\"step\">第 5 步</span>\n            <span class=\"t\">有问题先翻常见问题</span>\n            <p class=\"d\">大部分疑问集中在流量计算、设备台数和续费上，下面把答案都摊开了。</p>\n          </li>\n        </ol>\n      </div>\n    </header>\n\n    <section id=\"start\">\n      <div class=\"wrap\">\n        <span class=\"kicker\">从哪里开始</span>\n        <h2>这一页能帮你解决什么</h2>\n        <p class=\"lead\">它不劝你买，也不绕弯子。就是把你订阅前会想知道的几件事——多少钱、给多少、装在哪、怎么用——按顺序讲一遍。</p>\n        <div class=\"card\">\n          <h3>三件先想清楚的事</h3>\n          <ul>\n            <li><strong>用途：</strong>只是日常浏览、看视频，还是要在游戏或远程办公里对延迟敏感，这决定了你该看普通节点池还是专线档位。</li>\n            <li><strong>人数：</strong>一个人用和一家人用，设备数差别很大，别为了省几十块每个月反复纠结。</li>\n            <li><strong>周期：</strong>先用一个月试试是最稳妥的方式，跑顺了再考虑年付。</li>\n          </ul>\n          <p>下面每一节都可以单独看，左侧目录随时能跳回去。</p>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"plans\">\n      <div class=\"wrap\">\n        <span class=\"kicker\">套餐怎么选</span>\n        <h2>三档订阅，一档一档往下看</h2>\n        <p class=\"lead\">从用量最少的一档开始往上排。每一档的月付和年付都写在一起，你自己算哪个划算。</p>\n\n        <article class=\"plan\">\n          <div class=\"plan-head\">\n            <h3>基础版</h3>\n            <div class=\"plan-price\">¥15<small> /月</small></div>\n          </div>\n          <div class=\"plan-body\">\n            <ul>\n              <li>每月 100GB 流量</li>\n              <li>支持 3 台设备同时在线</li>\n              <li>基础流媒体解锁</li>\n              <li>普通线路节点池</li>\n            </ul>\n            <p class=\"plan-foot\">按年付 ¥150/年，折下来每月不到十三块。适合手机加电脑两个人以内的轻度使用。</p>\n          </div>\n        </article>\n\n        <article class=\"plan is-featured\">\n          <div class=\"plan-head\">\n            <h3>旗舰版</h3>\n            <div class=\"plan-price\">¥35<small> /月</small></div>\n          </div>\n          <div class=\"plan-body\">\n            <span class=\"plan-note\">多数人落在这一档</span>\n            <ul>\n              <li>每月 300GB 流量</li>\n              <li>支持 5 台设备同时在线</li>\n              <li>全节点原生流媒体解锁</li>\n              <li>IPLC 专线游戏加速优化</li>\n              <li>7×24 优先工单支持</li>\n            </ul>\n            <p class=\"plan-foot\">按年付 ¥350/年。流量够两三个人分着用，也照顾到对延迟敏感的场合。提工单会排在前面。</p>\n          </div>\n        </article>\n\n        <article class=\"plan\">\n          <div class=\"plan-head\">\n            <h3>团队版</h3>\n            <div class=\"plan-price\">¥85<small> /月</small></div>\n          </div>\n          <div class=\"plan-body\">\n            <ul>\n              <li>每月 1000GB 流量</li>\n              <li>支持 20 台设备同时在线</li>\n              <li>VIP 专属高带宽节点</li>\n              <li>支持企业定制路由</li>\n              <li>专属客户经理服务</li>\n            </ul>\n            <p class=\"plan-foot\">按年付 ¥850/年。设备多、要统一管理的小团队比较合适。定制路由怎么配，建议订阅前先跟我们说清楚需求。</p>\n          </div>\n        </article>\n\n        <p>三档之间的差别主要在流量、设备台数和线路类型上，功能上不额外设门槛。拿不准就选旗舰版，进退都方便。</p>\n      </div>\n    </section>\n\n    <section id=\"clients\">\n      <div class=\"wrap\">\n        <span class=\"kicker\">客户端</span>\n        <h2>你手上的设备该装什么</h2>\n        <p class=\"lead\">目前我们没有提供官方下载页和安装包来源，所以这里不写下载地址，只说明各平台的现状。拿到订阅信息后，你可以在已安装的兼容客户端里导入使用。</p>\n\n        <div class=\"client-grid\">\n          <div class=\"client\">\n            <h3>Windows / macOS 桌面端</h3>\n            <p>桌面场景建议使用你信任的通用客户端，导入订阅链接即可。我们不提供官方安装包，也不代你选择软件。</p>\n            <p class=\"status\">无官方下载地址</p>\n          </div>\n          <div class=\"client\">\n            <h3>iOS / iPadOS</h3>\n            <p>受应用商店上架规则影响，这类系统通常需要在商店里自行寻找兼容客户端。具体可用的软件请以商店实际搜索结果为准。</p>\n            <p class=\"status\">无官方下载地址</p>\n          </div>\n          <div class=\"client\">\n            <h3>Android</h3>\n            <p>Android 端可选的兼容客户端较多，安装来源建议只用可信渠道。订阅信息按客户端提示导入。</p>\n            <p class=\"status\">无官方下载地址</p>\n          </div>\n          <div class=\"client\">\n            <h3>路由器与电视盒子</h3>\n            <p>部分设备支持在路由器层面统一配置，这样家里所有设备都走同一条线路，具体取决于你设备本身的能力。</p>\n            <p class=\"status\">视设备而定</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"howto\">\n      <div class=\"wrap\">\n        <span class=\"kicker\">上手四步</span>\n        <h2>订阅之后的实际操作</h2>\n        <p class=\"lead\">从拿到订阅信息到第一条线路跑通，通常用不了几分钟。按这个顺序来，出问题时也容易定位。</p>\n        <ol class=\"steps\">\n          <li>\n            <h3>在客户端里添加订阅</h3>\n            <p>打开你选定的客户端，找到“添加订阅”或类似入口，把拿到的订阅信息粘进去，保存后先手动更新一次节点列表。</p>\n          </li>\n          <li>\n            <h3>挑一条线路先连上</h3>\n            <p>不用一上来就挨个试。先用默认排序里靠前的一条，确认能正常打开网页，再去比较延迟。</p>\n          </li>\n          <li>\n            <h3>看流量用量对不对得上</h3>\n            <p>用了一两天之后回头看一眼用量。如果涨得比预期快，可能是有设备在后台持续传输，值得查一下。</p>\n          </li>\n          <li>\n            <h3>设备多了再调同时在线数</h3>\n            <p>三台以上同时用就要留意上限了。超出时老设备会被挤掉，不是故障，是额度到了。</p>\n          </li>\n        </ol>\n      </div>\n    </section>\n\n    <section id=\"billing\">\n      <div class=\"wrap\">\n        <span class=\"kicker\">计费与流量</span>\n        <h2>钱怎么算，流量怎么算</h2>\n        <div class=\"card\">\n          <h3>月付与年付</h3>\n          <p>月付按自然月计，年付一次性付清对应金额。年付的价格在套餐卡片里单独标了，换算成每月会便宜一些。具体以付款时页面显示为准。</p>\n        </div>\n        <div class=\"card\">\n          <h3>流量周期</h3>\n          <p>每月额度按订阅周期重置。当月没用完的部分不结转到下个月，所以不必为了“用满”而刻意多开。</p>\n        </div>\n        <div class=\"card\">\n          <h3>设备数不是设备总数</h3>\n          <p>套餐里写的是同时在线设备数。你可以在更多设备上装好客户端，但同一时间只能有对应台数在线。</p>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"faq\">\n      <div class=\"wrap\">\n        <span class=\"kicker\">常见问题</span>\n        <h2>你可能想问的几件事</h2>\n        <p class=\"lead\">点开每一条看答案。没找到的，可以先对照上面几节的内容。</p>\n\n        <details>\n          <summary>我用不满 100GB，还有更便宜的档吗？</summary>\n          <div class=\"ans\">\n            <p>基础版是现有的最低一档，没有更小的套餐。如果你只是偶尔用，可以先用基础版按月试一个月，看实际用量再决定要不要往上升。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>套餐里说的“同时在线设备”怎么算？</summary>\n          <div class=\"ans\">\n            <p>指同一时刻正在连接中的设备数量。手机、电脑、平板、电视盒子各算一台。装了很多台但只有三台在线，就按三台算。超出上限时，先连上的设备可能被后来的挤掉。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>旗舰版的 IPLC 专线和普通线路差在哪？</summary>\n          <div class=\"ans\">\n            <p>线路类型不同，主要影响的是稳定性与延迟表现，对延迟敏感的场景感受更明显。日常浏览网页、看视频，普通线路通常也够用。值不值得多花钱，看你在不在意这一点。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>你们提供客户端下载吗？</summary>\n          <div class=\"ans\">\n            <p>目前没有官方下载页，也没有统一的安装包来源。我们只提供订阅信息，客户端由你自己选。这也意味着安装来源的安全性需要你自己把关，尽量只用可信渠道。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>可以中途从月付改成团队版吗？</summary>\n          <div class=\"ans\">\n            <p>可以在下一周期开始前升级到更高一档，额度与设备数随新套餐走。降档同理。已付周期的费用怎么处理，以付款时页面上的说明为准。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>流量超了会怎样？</summary>\n          <div class=\"ans\">\n            <p>当月额度用完后，通常需要等到下个周期重置，或者升级到额度更高的一档。不想中途断掉的话，建议在用量接近上限时提前处理，别等到最后一个晚上。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>年付一定比月付划算吗？</summary>\n          <div class=\"ans\">\n            <p>按单价算确实更低，但前提是你确定会持续用满一年。如果只是短期需要，或者还在试阶段，按月更稳妥。省下的钱不该用“万一不用了”来换。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>团队版的定制路由需要提前沟通吗？</summary>\n          <div class=\"ans\">\n            <p>需要。定制路由涉及你内部网络的实际情况，订阅前先把设备规模、网络结构和使用场景说清楚，我们才能判断方案是否可行，避免订阅后发现对不上。</p>\n          </div>\n        </details>\n      </div>\n    </section>\n\n    <footer>\n      <div class=\"wrap\">\n        <p><strong>MarsLink</strong> · 本页内容为订阅与使用说明，价格与权益以页面更新为准。页面不提供下载链接。</p>\n      </div>\n    </footer>\n  </main>\n</div>",
